    let curLang = localStorage.getItem('site_lang') || 'zh';
    const btnZh = document.getElementById('btnZh');
    const btnEn = document.getElementById('btnEn');

    function applyLang(lang) {
      curLang = lang;
      localStorage.setItem('site_lang', lang);
      if (btnZh) btnZh.classList.toggle('active', lang === 'zh');
      if (btnEn) btnEn.classList.toggle('active', lang === 'en');
      const d = I18N_ABOUT[lang];
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const k = el.getAttribute('data-i18n');
        if (d && d[k]) el.innerHTML = d[k];
      });
    }

    if (btnZh) btnZh.addEventListener('click', () => applyLang('zh'));
    if (btnEn) btnEn.addEventListener('click', () => applyLang('en'));
    applyLang(curLang);
  </script>
