      en: {
        brand: 'HerbAtlas',
        back_home: '← Back to Home',
        nav_home: 'Home',
        nav_all: 'All Herbs (50)',
        nav_classics: 'Materia Medica',
        nav_decoct: 'Decoction Rules',
        disc_title: 'Terms of Academic Use & Medical Disclaimer',
        disc_hero_banner: '⚠️ Core Disclaimer: All content hosted on this website (HerbAtlas), including botanical origins, traditional dosages, modern pharmacological mechanisms, active compounds, classical formulas, and PubMed citations, is strictly for educational, historical, and phytopharmacological research purposes. Nothing herein constitutes clinical diagnostic criteria, medical therapy, or prescription guidance.',
        sec_1_t: '1. No Medical Advice or Prescription Substitute',
        sec_1_c1: 'Traditional Chinese Medicine is founded upon systemic holism and pattern differentiation (Bian Zheng Lun Zhi). Clinical applications, processing specifications, and metabolic pathways vary widely depending on personal constitution, seasonal conditions, disease stages, and synergistic interactions.',
        sec_1_c2: 'No content on this site represents medical advice or professional clinical evaluation. Users must not rely on this dataset to self-prescribe, formulate, or adjust existing medical regimens. Consult a licensed medical physician or certified herbalist for health concerns.',
        sec_2_t: '2. Limitations of In Vitro & Preclinical Research',
        sec_2_c1: 'Modern pharmacological mechanisms and active monomer pathways displayed on this platform are derived from published in vitro cell assays, in vivo animal models, and computational molecular docking evaluations.',
        sec_2_c2: 'Bioactivities observed in preclinical models do NOT directly equate to verified clinical efficacy in humans. Bioavailability, first-pass metabolism, pharmacokinetics, and systemic distribution require confirmation through randomized, double-blind controlled clinical trials (RCTs).',
        sec_3_t: '3. Dosages, Processing Forms & Toxicity Warnings',
        sec_3_c1: 'Dosage figures provided represent general theoretical ranges documented in historical pharmacopoeias and standard compendia.',
        sec_3_c2: 'Clinical safety fundamentally depends on distinct processing methods (e.g., raw vs. prepared Pinellia, raw vs. prepared Polygonum multiflorum, which exhibit entirely different toxicity profiles). Unsupervised administration, overdose, or failure to observe strict boiling protocols may result in severe adverse reactions or organ toxicity.',
        sec_4_t: '4. Third-Party Databases & External Literature',
        sec_4_c1: 'External hyperlinks (including NCBI/PubMed and Chinese Text Project CText) are provided solely for academic convenience in verifying primary literature.',
        sec_4_c2: 'HerbAtlas exercises no control over third-party website integrity, legal copyright, scientific conclusions, or ongoing server availability, and assumes no liability for external materials.',
        btn_accept: '✓ Understood & Return to Home'
      }
    };

    let currentLang = localStorage.getItem('site_lang') || 'zh';
    const btnZh = document.getElementById('btnZh');
    const btnEn = document.getElementById('btnEn');

    function applyLang(lang) {
      currentLang = lang;
      localStorage.setItem('site_lang', lang);

      if (btnZh) btnZh.classList.toggle('active', lang === 'zh');
      if (btnEn) btnEn.classList.toggle('active', lang === 'en');

      const dict = I18N_DICT[lang];
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (dict && dict[key]) el.innerHTML = dict[key];
      });
    }

    if (btnZh) btnZh.addEventListener('click', () => applyLang('zh'));
    if (btnEn) btnEn.addEventListener('click', () => applyLang('en'));

    applyLang(currentLang);
  </script>
